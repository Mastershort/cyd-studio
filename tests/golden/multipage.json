        {"id": "w2", "type": "sensor_value", "x": 2, "y": 0, "w": 2, "h": 1, "entity": "sensor.wohnzimmer_temperatur", "props": {"label": "Wohnzimmer", "icon": "mdi:thermometer", "unit": "°C", "decimals": 1, "tap_page": "klima"}},
        {"id": "w3", "type": "toggle_tile", "x": 0, "y": 1, "w": 2, "h": 1, "entity": "light.wohnzimmer", "props": {"label": "Licht", "icon": "mdi:lightbulb"}},
        {"id": "w4", "type": "binary_indicator", "x": 2, "y": 1, "w": 2, "h": 1, "entity": "binary_sensor.fenster_wohnzimmer", "props": {"label": "Fenster", "icon": "mdi:window-open-variant", "text_on": "Offen", "text_off": "Zu"}},
        {"id": "w5", "type": "scene_button", "x": 0, "y": 2, "w": 2, "h": 1, "action": {"service": "script.turn_on", "target": "script.alles_aus"}, "props": {"label": "Alles aus", "icon": "mdi:power"}},
        {"id": "w6", "type": "page_button", "x": 2, "y": 2, "w": 2, "h": 1, "props": {"target": "licht_details"}}
      ]
    },
    {
      "id": "klima", "name": "Klima", "icon": "mdi:thermostat",
      "widgets": [
        {"id": "t", "type": "label", "x": 0, "y": 0, "w": 4, "h": 1, "props": {"text": "Raumklima \"Süd\": Übersicht", "size": "l"}},
        {"id": "hum", "type": "sensor_value", "x": 0, "y": 1, "w": 2, "h": 2, "entity": "sensor.wohnzimmer_luftfeuchte", "props": {"label": "Luftfeuchte", "icon": "mdi:water-percent", "unit": "%", "decimals": 0}},
        {"id": "co2", "type": "sensor_value", "x": 2, "y": 1, "w": 2, "h": 2, "entity": "sensor.wohnzimmer_co2", "props": {"label": "CO₂", "icon": "mdi:molecule-co2", "unit": "ppm", "decimals": 0}}
      ]
    },
    {
      "id": "licht_details", "name": "Lichter", "icon": "mdi:lightbulb-group", "parent": "home", "timeout_s": 15,
      "widgets": [
        {"id": "title", "type": "page_title", "x": 0, "y": 0, "w": 4, "h": 1, "props": {"size": "l"}},
        {"id": "l1", "type": "toggle_tile", "x": 0, "y": 1, "w": 2, "h": 1, "entity": "light.wohnzimmer", "props": {"label": "Decke", "icon": "mdi:ceiling-light"}},
        {"id": "l2", "type": "toggle_tile", "x": 2, "y": 1, "w": 2, "h": 1, "entity": "switch.stehlampe", "props": {"label": "Stehlampe", "icon": "mdi:floor-lamp"}},
        {"id": "l3", "type": "toggle_tile", "x": 0, "y": 2, "w": 4, "h": 1, "entity": "cover.rollladen", "props": {"label": "Rollladen", "icon": "mdi:window-shutter", "show_state": true}}
      ]
    }
